# Database Configuration
MONGODB_URI=mongodb://localhost:27017/orbitos

# JWT Secret Key (Generate a secure random string for production)
JWT_SECRET=your-secure-jwt-secret-key

# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local development only: shows "Continue as Local Admin" on the login screen.
# Never enable this on a server, tunnel (ngrok/cloudflared) or shared machine.
NEXT_PUBLIC_ENABLE_LOCAL_ADMIN=false
